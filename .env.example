POSTGRES_PASSWORD=change_me
# Both my_summarizer (text generation) and my_embedder (embeddings) run on
# OpenRouter by default -- no local model inference on this machine at all.
# Get a key at https://openrouter.ai/keys. bring-up.sh fills this in
# automatically from ~/.openrouter_key -- you shouldn't normally need to
# edit this by hand.
OPENROUTER_API_KEY=
# Optional -- only needed if sql/02-aidb-models.sql is switched to the
# OpenAI-backed alternative instead. Leave blank otherwise.
OPENAI_API_KEY=
